{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2022",
    "lib": ["ES2022"],
    // ESM. @google/genai ships ESM-first and its type declarations are not
    // reachable from a CommonJS file, so the alternative was a lazy dynamic
    // import inside the Gemini adapter — a change to moved code, to work
    // around a build setting. Relative imports carry a .js extension because
    // that is what Node's ESM resolver requires.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=4000

# Where the Next frontend is served from. CORS is restricted to this origin —
# never "*". http://localhost:3000 is always allowed while NODE_ENV is not
# "production", so this only needs setting for a deployed frontend.
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Secrets — every one of these lives here and nowhere else.
# The frontend repo holds no keys at all.
# ---------------------------------------------------------------------------

# Classic or fine-grained GitHub token, public repo read access only.
GITHUB_TOKEN=

# Google AI Studio key (Gemini Developer API — not Vertex AI).
# Fallback provider. Its free tier allows only 20 generate requests per day
# per model, which is why it is no longer the primary — one eight-question
# interview is 17+ calls.
GEMINI_API_KEY=

# Groq key. Primary provider: 1,000 requests a day against Gemini's 20, and
# it answers in roughly a second.
GROQ_API_KEY=

# Model ids. Optional — these are the defaults compiled in.
# Preview models get withdrawn at short notice, so overriding here is a
# one-line fix rather than a code change. Check GET /health after any edit.
GEMINI_MODEL=gemini-3-flash-preview
GROQ_MODEL=openai/gpt-oss-120b

# Cloudinary. Attachments are uploaded straight from the browser, so the secret
# here is never sent anywhere — it only signs the ticket that permits one
# upload. The signature is what constrains type, size, folder and, for images,
# the resize and metadata strip. Keep the secret server-side: a signing key in
# the browser is an open write endpoint into this account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# External state — Upstash Redis, over the REST API.
#
# Not optional in production. The profile cache, the provider circuit breaker,
# the per-IP rate limit and the daily vision cap all live here. Under
# serverless each invocation is a fresh process, so any of these held in memory
# would silently stop working: the cache would miss, the breaker would reopen,
# and — the dangerous pair — the rate limit and the vision cap would fail
# *open*, allowing everything while still reporting a limit.
#
# The code degrades rather than crashes when these are unset: it falls through
# to the uncached, unlimited path and logs that it has done so once. That is
# survivable locally and is not a state to deploy in.
#
# REST rather than a TCP client on purpose — a serverless invocation has no
# stable lifetime to hold a pooled connection across.
# ---------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
